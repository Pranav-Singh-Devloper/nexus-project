generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Uses Pooler (for speed)
  directUrl = env("DIRECT_URL") // Uses Direct (for migrations)
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  googleId       String?         @unique
  password       String? // <--- ADD THIS (Optional, because Google users won't have one)
  name           String?
  avatar         String?
  createdAt      DateTime        @default(now())
  projects       Project[]
  socialAccounts SocialAccount[]
  scheduledPosts ScheduledPost[]
  postDrafts     PostDraft[]
}

model SocialAccount {
  id                String   @id @default(uuid())
  provider          String // "linkedin", "x"
  providerAccountId String
  accessToken       String
  refreshToken      String?
  expiresAt         DateTime // Required for refresh token logic

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

model ScheduledPost {
  id             String   @id @default(uuid())
  content        String   @db.Text
  scheduledAt    DateTime // Always stored in UTC
  status         String   @default("pending") // pending | posting | published | failed
  retryCount     Int      @default(0)
  provider       String   @default("linkedin") // "linkedin", "x"
  providerPostId String?
  imageUrl       String?
  error          String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The draft this post was published from (keeps the drafts page in sync)
  draftId String?
  draft   PostDraft? @relation(fields: [draftId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

// A post being written in the composer. Kept after publishing as post history.
model PostDraft {
  id          String    @id @default(uuid())
  html        String    @default("") @db.Text
  imageUrl    String?
  imagePrompt String?   @db.Text
  imageStyle  String?
  hashtags    String[]  @default([])
  status      String    @default("draft") // draft | scheduled | published | failed
  provider    String? // set once scheduled or published
  scheduledAt DateTime?
  publishedAt DateTime?
  postUrl     String?
  error       String?

  projectId String? // research report it was generated from
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scheduledPosts ScheduledPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status, updatedAt])
}

model Project {
  id        String   @id @default(uuid())
  title     String
  status    String   @default("draft")
  report    String?  @db.Text
  createdAt DateTime @default(now())

  // pgvector column used by hybrid search (written/read with raw SQL).
  // Must stay in the schema, otherwise `prisma db push` / `migrate` drops it.
  embedding Unsupported("vector(384)")?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Relation to Notes
  notes      Note[]
  postDrafts PostDraft[]
}

model Note {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Daily / monthly usage counts that keep Nexus inside free-tier API limits.
// scope is "global" or a user id; period is "2026-11-09" (day) or "2026-11" (month).
model UsageCounter {
  scope     String
  action    String
  period    String
  count     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  @@id([scope, action, period])
}

// Cached web-search results (written by the AI engine). Saves Tavily credits and
// makes evaluation runs reproducible.
model SearchCache {
  key       String   @id
  query     String
  params    Json
  results   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}
