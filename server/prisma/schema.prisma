generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Uses Pooler (for speed)
  directUrl = env("DIRECT_URL")   // Uses Direct (for migrations)
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  googleId  String?  @unique
  password  String?  // <--- ADD THIS (Optional, because Google users won't have one)
  name      String?
  avatar    String?
  createdAt DateTime @default(now())
  projects  Project[]
  socialAccounts SocialAccount[]
  scheduledPosts ScheduledPost[]
}


model SocialAccount {
  id                String   @id @default(uuid())
  provider          String   // "linkedin", "x"
  providerAccountId String
  accessToken       String
  refreshToken      String?
  expiresAt         DateTime // Required for refresh token logic
  
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

model ScheduledPost {
  id              String   @id @default(uuid())
  content         String   @db.Text
  scheduledAt     DateTime // Always stored in UTC
  status          String   @default("pending") // pending | posting | published | failed
  retryCount      Int      @default(0)
  provider        String   @default("linkedin") // "linkedin", "x"
  providerPostId  String?
  imageUrl        String?
  error           String?

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
}

model Project {
  id        String   @id @default(uuid())
  title     String
  status    String   @default("draft")
  report    String?  @db.Text
  createdAt DateTime @default(now())

  // pgvector column used by hybrid search (written/read with raw SQL).
  // Must stay in the schema, otherwise `prisma db push` / `migrate` drops it.
  embedding Unsupported("vector(384)")?

  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  // Relation to Notes
  notes     Note[]
}

model Note {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}