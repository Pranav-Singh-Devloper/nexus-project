# --- Database (Neon or local Postgres with the pgvector extension) ---
# Pooled connection, used by the app
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus
# Direct (non-pooled) connection, used by Prisma migrations
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/nexus

# --- App ---
# Long random string; signs session JWTs and the OAuth session cookie
COOKIE_KEY=change-me-to-a-long-random-string
# Where the React app runs (exact origin, used for CORS and redirects)
CLIENT_URL=http://localhost:5173
# Public URL of this server (used to build OAuth redirect URLs)
SERVER_URL=http://localhost:5001
# The FastAPI AI engine
AI_SERVICE_URL=http://localhost:8000
NODE_ENV=development
PORT=5001

# --- Google sign-in (optional) ---
# Redirect URL: {SERVER_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- LinkedIn posting (optional) ---
# Redirect URL: {SERVER_URL}/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- X posting (optional) ---
# Redirect URL: {SERVER_URL}/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Free hosting ---
# Shared secret for POST /internal/run-scheduler (called by .github/workflows/scheduler.yml)
CRON_SECRET=

# --- Embeddings (optional) ---
# Cloudflare Workers AI. If unset, embeddings come from the AI engine (FastEmbed).
CF_ACCOUNT_ID=
CF_API_TOKEN=
