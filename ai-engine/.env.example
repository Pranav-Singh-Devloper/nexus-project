# LLM (Groq, OpenAI-compatible API)
GROQ_API_KEY=
# Optional second key, used automatically when the first one is rate limited
GROQ_API_KEY_BACKUP=
# Optional; defaults to openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# Web search for the research agent
TAVILY_API_KEY=

# Image generation for LinkedIn posts
WAVESPEED_API_KEY=
